{
  "description": "feature-ladder: report Hindsight reachability at session start; require every ladder subagent to retain memories (or say why not) before it finishes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_hindsight.sh\"",
            "timeout": 10,
            "statusMessage": "Checking Hindsight memory"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/require_retained.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
