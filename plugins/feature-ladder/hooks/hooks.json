{
  "description": "feature-ladder: resolve this repository's Hindsight bank at session start (and say loudly when memory is off), start a new session subagent budget, write queued memories unattended when a session starts or ends (a detached script, no model, never during a run), route every Hindsight tool call to the repository's bank and record a memory write only once it has happened, enforce the session subagent budget and the per-feature spawn rules (no reviews, scribes or Fable calls inside a run), record each subagent's token usage in the run's ledger, and audit outside-repo shell commands while a ladder run is active.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/hindsight-memory/scripts/resolve_bank.py\" --session-start",
            "timeout": 30,
            "statusMessage": "Resolving Hindsight bank for this repository"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/orchestration-ladder/scripts/session_budget.py\" --session-start",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/hindsight-memory/scripts/memory_gate.py\" flush --background",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Hh]indsight.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/hindsight-memory/scripts/resolve_bank.py\" --pretooluse",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/orchestration-ladder/scripts/session_budget.py\" --pretooluse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_feature-ladder_hindsight__retain",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/hindsight-memory/scripts/resolve_bank.py\" --posttooluse",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/require_retained.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ledger.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/hindsight-memory/scripts/memory_gate.py\" flush --background",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
